  const handleApplyPreset = (preset: Preset) => {
    const newStages: TpStage[] = preset.stages.map((s, idx) => ({
      id: `${Date.now()}-${idx}`,
      mode: 'ROE',
      roePercent: s.roePercent,
      targetPrice: '',
      closePercent: s.closePercent,
